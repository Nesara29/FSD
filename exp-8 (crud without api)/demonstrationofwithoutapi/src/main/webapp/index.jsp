<html>
<head>
</head>
<body>
<div>
<div>PREFORMING CURD OPERATION WITHOUT USING API</div>

<div>
<h1>ADD OPERATION</h1>
<form action="addCpc">
Cpc cid: <input type="text" name="cid"/><br/>
Cpc cname: <input type="text" name="cname"/><br/>
Cpc clocation: <input type="text" name="clocation"/><br/>
<input type="submit"/>
</form>
</div>

<div>
<h1>GET OPERATION</h1>
<form action="getCpc">
Cpc cid: <input type="text" name="cid"/><br/>
<input type="submit"/>
</form>
</div>

<div>
<h1>UPDATE OPERATION</h1>
<form action="updCpc">
Cpc cid: <input type="text" name="cid"/><br/>
<input type="submit"/>
</form>
</div>

<div>
<h1>DELETE OPERATION</h1>
<form action="delCpc">
Cpc cid: <input type="text" name="cid"/><br/>
<input type="submit"/>
</form>
</div>

</div>
</body>
</html>